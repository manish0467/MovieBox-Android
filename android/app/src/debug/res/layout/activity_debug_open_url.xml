<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_open_url_title"
            android:textAppearance="?android:attr/textAppearanceLarge" />
        <EditText
            android:id="@+id/debug_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debug_url_hint"
            android:inputType="textUri"
            android:singleLine="true" />
        <EditText
            android:id="@+id/debug_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debug_subtitle_hint"
            android:inputType="textUri"
            android:singleLine="true" />
        <EditText
            android:id="@+id/debug_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/debug_media_title_hint"
            android:inputType="textCapSentences"
            android:singleLine="true" />
        <EditText
            android:id="@+id/debug_headers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/debug_headers_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="2" />
        <Button
            android:id="@+id/debug_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_open_player" />
    </LinearLayout>
</ScrollView>
